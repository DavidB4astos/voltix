# Customer APIs: POST /cliente and PATCH /cliente/{cliente_id}.
# Group voltix-customer: POST /login, GET /me, GET/POST /addresses,
# PATCH/DELETE /addresses/{address_id}.
XANO_CUSTOMER_URL=
XANO_CUSTOMER_LOGIN_URL=
XANO_CUSTOMER_ME_URL=
XANO_CUSTOMER_ADDRESSES_URL=
# Voltix Customer cart endpoints: GET /cart, POST /cart/items,
# PATCH/DELETE /cart/items/{item_id}.
XANO_CART_URL=
# Voltix Customer checkout/order endpoints:
# POST /checkout/review, POST /checkout/confirm, GET /orders,
# GET /orders/{order_id}, POST /orders/{order_id}/payment/simulate.
XANO_CHECKOUT_REVIEW_URL=
XANO_CHECKOUT_CONFIRM_URL=
XANO_ORDERS_URL=
XANO_PAYMENT_SIMULATION_URL=

# Internal customer reads: published list URL and detail URL with {customer_id}.
XANO_INTERNAL_CUSTOMERS_URL=
XANO_INTERNAL_CUSTOMER_DETAILS_URL=
